# Only needed if you add a WalletConnect-based wallet to src/wagmi.ts.
# QoreX and injected browser wallets do not use it.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: "local" to use your own deployed stack (see docs/DEVELOPING.md); default is the team's shared deployment.
VITE_DEPLOYMENT=
# Optional: REST (LCD) base URL or proxy path for bank balances; default /lcd-testnet (the Vite dev proxy).
VITE_REST_URL=
