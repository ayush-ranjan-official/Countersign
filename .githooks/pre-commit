#!/bin/sh
# Blocks secrets from being committed. Enable once per clone:  git config core.hooksPath .githooks
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    *.env|*.env.*|.env|*/.env) case "$f" in *.env.example) ;; *) echo "BLOCKED: env file staged: $f"; fail=1;; esac ;;
    refs/*) echo "BLOCKED: refs/ staged: $f"; fail=1 ;;
    *.pem|*.key|*keystore*) echo "BLOCKED: key file staged: $f"; fail=1 ;;
  esac
done
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -Ev '=[[:space:]]*"?0x0{64}"?[[:space:]]*$' | grep -Eq 'QRC1-[A-Z0-9]{4}|PRIVATE_KEY[A-Z_]*=[[:space:]]*"?(0x)?[0-9a-fA-F]{64}|MNEMONIC[A-Z_]*=[[:space:]]*"?[a-z]+( [a-z]+){11}'; then
  echo "BLOCKED: staged content looks like a private key / mnemonic / PQC recovery code"; fail=1
fi
[ $fail -eq 0 ] || { echo "Commit refused by .git/hooks/pre-commit"; exit 1; }
exit 0
