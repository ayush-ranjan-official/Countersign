{
  "name": "contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Foundry project for the QoreChain EVM, with a helper that opens the EVM authorisation window.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx scripts/keygen.ts",
    "accounts": "tsx --env-file=.env scripts/accounts.ts",
    "spike:s1": "tsx --env-file-if-exists=.env scripts/spike-s1.ts",
    "register": "tsx --env-file=.env scripts/register.ts",
    "fund": "tsx --env-file=.env scripts/fund.ts",
    "convert-fusd": "tsx --env-file=.env scripts/convert-fusd.ts",
    "spike:s2": "tsx scripts/spike-s2.ts",
    "spike:s3": "tsx --env-file=.env scripts/spike-s3.ts",
    "spike:s5": "tsx --env-file=.env scripts/spike-s5.ts",
    "deploy:bond": "forge script script/DeployBond.s.sol --rpc-url qorechain_testnet --broadcast --slow",
    "deploy:spike-escrow": "forge script script/DeploySpikeEscrow.s.sol --rpc-url qorechain_testnet --broadcast --slow",
    "deploy:countersign": "forge script script/DeployCountersign.s.sol --rpc-url qorechain_testnet --broadcast --slow",
    "trade": "tsx --env-file=.env scripts/trade.ts",
    "attack": "tsx --env-file=.env scripts/attack.ts",
    "counterparty": "tsx --env-file=.env scripts/counterparty.ts",
    "nav-poster": "tsx --env-file-if-exists=.env scripts/nav-poster.ts",
    "deploy:own:bond": "DEPLOYMENTS_DIR=deployments/local FOUNDRY_BROADCAST=deployments/local/broadcast forge script script/DeployBond.s.sol --rpc-url qorechain_testnet --broadcast --slow",
    "deploy:own:countersign": "DEPLOYMENTS_DIR=deployments/local FOUNDRY_BROADCAST=deployments/local/broadcast forge script script/DeployCountersign.s.sol --rpc-url qorechain_testnet --broadcast --slow"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
